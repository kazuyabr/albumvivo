# Freebuff — variáveis de ambiente (copie para .env)
# Nenhum valor aqui é obrigatório em desenvolvimento: os defaults de config/app.php servem.

APP_NAME="Freebuff"
APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

# --- Banco (MySQL/MariaDB em produção e no Docker; sqlite nos testes) ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=freebuff
DB_USER=freebuff
DB_PASS=
# DB_DRIVER=sqlite -> usado pelos testes unitários sem servidor
# DB_SQLITE_PATH=/caminho/absoluto/database.sqlite

# --- Provedores de IA -------------------------------------------------
# mock     -> sem rede, grava placeholders (CI/testes)
# replicate-> principal (pago após créditos de teste)
# huggingface -> free tier (fallback)
# comfyui  -> self-hosted opcional
AI_PROVIDER=mock
REPLICATE_API_TOKEN=
HF_TOKEN=
COMFYUI_URL=http://host.docker.internal:8188

# --- Storage ----------------------------------------------------------
# local -> storage/uploads (Docker / dev)
# r2    -> Cloudflare R2 (assinatura S3 escrita à mão, sem SDK)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# --- Pagamentos -------------------------------------------------------
# mercadopago -> Checkout Pro com order bump nativo
# hero        -> checkout externo (https://herocheckout.ai/)
# manual      -> liberação manual pelo admin (dev/teste)
PAYMENT_DRIVER=mercadopago
MP_ENV=test
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
HERO_CHECKOUT_URL=

# --- Segredos ---------------------------------------------------------
APP_KEY=
